generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model RealtimeSnapshot {
  id          Int      @id @default(autoincrement())
  capturedAt  DateTime @default(now())
  activeUsers Int      @default(0)
  eventCount  Int      @default(0)
  keyEvents   Int      @default(0)
  pageViews   Int      @default(0)
  topSources  Json?
  topPages    Json?
  topCities   Json?
  createdAt   DateTime @default(now())

  @@index([capturedAt])
  @@map("realtime_snapshots")
}

model TrafficBySource {
  id             Int      @id @default(autoincrement())
  capturedAt     DateTime
  source         String
  medium         String
  sessions       Int      @default(0)
  users          Int      @default(0)
  newUsers       Int      @default(0)
  bounceRate     Float    @default(0)
  engagementRate Float    @default(0)
  conversions    Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([capturedAt])
  @@index([source, medium])
  @@map("traffic_by_source")
}

model TrafficByHour {
  id          Int      @id @default(autoincrement())
  capturedAt  DateTime
  dateHour    String
  sessions    Int      @default(0)
  users       Int      @default(0)
  conversions Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([capturedAt])
  @@index([dateHour])
  @@map("traffic_by_hour")
}

model TrafficByGeo {
  id          Int      @id @default(autoincrement())
  capturedAt  DateTime
  country     String
  region      String   @default("")
  city        String   @default("")
  sessions    Int      @default(0)
  users       Int      @default(0)
  conversions Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([capturedAt])
  @@map("traffic_by_geo")
}

model TrafficByDevice {
  id             Int      @id @default(autoincrement())
  capturedAt     DateTime
  deviceCategory String
  sessions       Int      @default(0)
  users          Int      @default(0)
  bounceRate     Float    @default(0)
  createdAt      DateTime @default(now())

  @@index([capturedAt])
  @@map("traffic_by_device")
}

model TrafficByLandingPage {
  id          Int      @id @default(autoincrement())
  capturedAt  DateTime
  landingPage String
  sessions    Int      @default(0)
  users       Int      @default(0)
  bounceRate  Float    @default(0)
  conversions Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([capturedAt])
  @@map("traffic_by_landing_page")
}

model ConversionEvent {
  id         Int      @id @default(autoincrement())
  capturedAt DateTime
  eventName  String
  source     String?
  medium     String?
  count      Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([capturedAt, eventName])
  @@map("conversion_events")
}

model TvSchedule {
  id          Int      @id @default(autoincrement())
  zlecenie    String?
  station     String
  airDate     DateTime
  program     String?
  product     String?
  spotLength  Int?
  pasmo       String?
  spotVersion String?
  createdAt   DateTime @default(now())

  @@index([airDate])
  @@index([station])
  @@map("tv_schedule")
}

model DailySnapshot {
  id         Int      @id @default(autoincrement())
  date       DateTime @db.Date
  sessions   Int      @default(0)
  users      Int      @default(0)
  newUsers   Int      @default(0)
  bounceRate Float    @default(0)
  conversions Int     @default(0)
  avgSessionDuration Float @default(0)
  createdAt  DateTime @default(now())

  @@unique([date])
  @@index([date])
  @@map("daily_snapshots")
}

model PeriodSummary {
  id                 Int      @id @default(autoincrement())
  period             String   // 'today' | '7d' | '30d' | '90d'
  windowOffset       Int      @default(0) // 0 = current window, 1 = the one before it
  startDate          DateTime @db.Date
  endDate            DateTime @db.Date
  sessions           Int      @default(0)
  users              Int      @default(0)
  newUsers           Int      @default(0)
  bounceRate         Float    @default(0)
  conversions        Int      @default(0)
  avgSessionDuration Float    @default(0)
  updatedAt          DateTime @updatedAt
  createdAt          DateTime @default(now())

  @@unique([period, windowOffset])
  @@map("period_summaries")
}

model ImportLog {
  id          Int      @id @default(autoincrement())
  filename    String
  recordCount Int
  mode        String   // "add" | "overwrite"
  importedAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  @@map("import_logs")
}

enum CrmLeadStatus {
  NEW
  IN_PROGRESS
  OFFER
  WON
  LOST
}

enum CrmLeadSource {
  PHONE
  EMAIL
  WEB_FORM
}

model CrmLead {
  id              String         @id
  clientName      String         @default("Klient Anonimowy")
  clientEmail     String?
  clientPhone     String?
  source          CrmLeadSource
  status          CrmLeadStatus  @default(NEW)
  thuliumStatus   String         // Nazwa statusu z Thulium (np. "Nowy", "Otwarty", "Zamknięty")
  queueName       String?        // Kolejka z Thulium (np. "Formularz_kontaktowy")
  subject         String?        // Temat zgłoszenia
  agentName       String?        // Nazwa przypisanego agenta
  value           Float          @default(0.0)
  url             String?        // Adres URL oferty/pojazdu
  referrer        String?        // Referrer (np. google, facebook)
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  thuliumCreatedAt DateTime
  thuliumUpdatedAt DateTime
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status])
  @@index([thuliumCreatedAt])
  @@map("crm_leads")
}

model CrmCall {
  id           String    @id
  phone        String
  direction    String    // "INBOUND" | "OUTBOUND"
  disposition  String    // "ANSWERED" | "NO_ANSWER" | "BUSY" etc.
  duration     Int
  billsec      Int
  agentName    String?
  queueName    String?
  timestamp    DateTime  // Data połączenia
  createdAt    DateTime  @default(now())

  @@index([timestamp])
  @@map("crm_calls")
}


model GscPerformance {
  id          Int      @id @default(autoincrement())
  capturedAt  DateTime
  url         String
  query       String?
  clicks      Int      @default(0)
  impressions Int      @default(0)
  ctr         Float    @default(0)
  position    Float    @default(0)
  createdAt   DateTime @default(now())

  @@index([capturedAt])
  @@index([url])
  @@map("gsc_performance")
}
